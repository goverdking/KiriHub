@@ -7167,6 +7167,74 @@ TJS_BEGIN_NATIVE_METHOD_DECL(/*func. name*/copyRect)
 }
 TJS_END_NATIVE_METHOD_DECL(/*func. name*/copyRect)
 //----------------------------------------------------------------------
+#ifdef __EMSCRIPTEN__
+TJS_BEGIN_NATIVE_METHOD_DECL(/*func. name*/clipAlphaRect)
+{
+	TJS_GET_NATIVE_INSTANCE(/*var. name*/_this, /*var. type*/tTJSNI_Layer);
+	if(numparams < 7) return TJS_E_BADPARAMCOUNT;
+
+	tTJSNI_BaseLayer *source = nullptr;
+	auto object = param[2]->AsObjectNoAddRef();
+	if(!object || TJS_FAILED(object->NativeInstanceSupport(TJS_NIS_GETINSTANCE,
+		tTJSNC_Layer::ClassID, reinterpret_cast<iTJSNativeInstance **>(&source))) || !source)
+		TVPThrowExceptionMessage(TVPSpecifyLayer);
+
+	auto destination = _this->GetMainImage();
+	auto sourceImage = source->GetMainImage();
+	if(!destination || !sourceImage || !destination->Is32BPP() || !sourceImage->Is32BPP())
+		return TJS_E_INVALIDPARAM;
+
+	const tjs_int64 dx = static_cast<tjs_int>(*param[0]), dy = static_cast<tjs_int>(*param[1]);
+	const tjs_int64 sx = static_cast<tjs_int>(*param[3]), sy = static_cast<tjs_int>(*param[4]);
+	const tjs_int64 width = static_cast<tjs_int>(*param[5]), height = static_cast<tjs_int>(*param[6]);
+	if(width <= 0 || height <= 0) return TJS_E_INVALIDPARAM;
+
+	const tTVPRect clip(_this->GetClipLeft(), _this->GetClipTop(),
+		_this->GetClipLeft() + _this->GetClipWidth(), _this->GetClipTop() + _this->GetClipHeight());
+	const tjs_int64 srcX = dx - sx, srcY = dy - sy;
+	const tjs_int64 left = std::max<tjs_int64>({clip.left, dx, srcX});
+	const tjs_int64 top = std::max<tjs_int64>({clip.top, dy, srcY});
+	const tjs_int64 right = std::min<tjs_int64>({clip.right, dx + width, srcX + sourceImage->GetWidth()});
+	const tjs_int64 bottom = std::min<tjs_int64>({clip.bottom, dy + height, srcY + sourceImage->GetHeight()});
+	const tjs_int clear = numparams > 7 && param[7]->Type() != tvtVoid ? param[7]->AsInteger() : -1;
+	const bool additive = _this->GetType() == ltAddAlpha;
+	const bool clearOutside = clear >= 0 && clear < 256 && (!additive || clear < 255);
+	if(!clearOutside && (left >= right || top >= bottom)) return TJS_S_OK;
+
+	// The bitmap is copy-on-write, including when source and destination coincide.
+	const tTVPBaseBitmap mask(*sourceImage);
+	_this->GetMainImagePixelBufferForWrite();
+	const tTVPRect affected = clearOutside ? clip : tTVPRect(left, top, right, bottom);
+	for(tjs_int y = affected.top; y < affected.bottom; ++y)
+	{
+		auto pixels = static_cast<tjs_uint32 *>(destination->GetScanLineForWrite(y));
+		const auto maskRow = y >= top && y < bottom && left < right ?
+			static_cast<const tjs_uint32 *>(mask.GetScanLine(y - srcY)) : nullptr;
+		for(tjs_int x = affected.left; x < affected.right; ++x)
+		{
+			const bool inside = maskRow && x >= left && x < right;
+			if(!inside && !additive)
+			{
+				pixels[x] = (pixels[x] & 0x00ffffff) | (static_cast<tjs_uint32>(clear) << 24);
+				continue;
+			}
+
+			const tjs_uint32 opacity = inside ? maskRow[x - srcX] >> 24 : clear;
+			const auto scale = [opacity](tjs_uint32 channel) {
+				const tjs_uint32 product = (channel & 0xff) * opacity;
+				return (product + (product >> 7)) >> 8;
+			};
+			const tjs_uint32 pixel = pixels[x];
+			pixels[x] = (scale(pixel >> 24) << 24) | (additive ?
+				(scale(pixel >> 16) << 16) | (scale(pixel >> 8) << 8) | scale(pixel) : pixel & 0x00ffffff);
+		}
+	}
+	_this->Update(affected);
+	return TJS_S_OK;
+}
+TJS_END_NATIVE_METHOD_DECL(/*func. name*/clipAlphaRect)
+//----------------------------------------------------------------------
+#endif

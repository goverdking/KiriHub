+		const tjs_uint64 pos = src->GetPosition();
+		if(src->Read(sniff, sizeof(sniff)) == (tjs_uint)sizeof(sniff)) {
+			src->SetPosition(pos);
+			if(!memcmp(sniff, "RIFF", 4) && !memcmp(sniff + 8, "WEBPVP8", 7)) {
+				TVPLoadHeaderWEBP(formatdata, src, dic);
+				return;
+			}
+		} else src->SetPosition(pos);
+	}
+

diff --git a/visual/LoadTLG.cpp b/visual/LoadTLG.cpp
index f3d3b953..353937da 100644
--- a/visual/LoadTLG.cpp
+++ b/visual/LoadTLG.cpp
@@ -473,6 +473,32 @@ void TVPLoadTLG(void* formatdata, void *callbackdata, tTVPGraphicSizeCallback si
 	tTVPGraphicScanLineCallback scanlinecallback, tTVPMetaInfoPushCallback metainfopushcallback,
 	tTJSBinaryStream *src, tjs_int keyidx,  tTVPGraphicLoadMode mode)
 {
+	// Some games store PNG/JPEG data inside PSB resources but request them
+	// through a ".tlg" virtual path. Sniff the real header before selecting
+	// the TLG decoder.
+	unsigned char sniff[16];
+	src->ReadBuffer(sniff, 16);
+	src->Seek(0, TJS_BS_SEEK_SET);
+	if(!memcmp(sniff, "RIFF", 4) && !memcmp(sniff + 8, "WEBPVP8", 7))
+	{
+		TVPLoadWEBP(formatdata, callbackdata, sizecallback, scanlinecallback,
+			metainfopushcallback, src, keyidx, mode);
+		return;
+	}
+	static const unsigned char pngsig[8] = {0x89, 'P', 'N', 'G', 0x0d, 0x0a, 0x1a, 0x0a};
+	if(!memcmp(sniff, pngsig, 8))
+	{
+		TVPLoadPNG(formatdata, callbackdata, sizecallback, scanlinecallback,
+			metainfopushcallback, src, keyidx, mode);
+		return;
+	}
+	if(sniff[0] == 0xff && sniff[1] == 0xd8 && sniff[2] == 0xff)
+	{
+		TVPLoadJPEG(formatdata, callbackdata, sizecallback, scanlinecallback,
+			metainfopushcallback, src, keyidx, mode);
+		return;
+	}
+
 	// read header
 	unsigned char mark[12];
 	src->ReadBuffer(mark, 11);

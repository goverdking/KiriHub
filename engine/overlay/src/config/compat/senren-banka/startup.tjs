// Host compatibility for the web build. The game's startup is loaded from data.xp3.
global.KirikiriPolyfillRoot = "file://./webcompat/";
Scripts.execStorage(global.KirikiriPolyfillRoot + "PolyfillInitialize.tjs");
Scripts.execStorage(global.KirikiriPolyfillRoot + "kh_compat.tjs");
Scripts.execStorage(global.KirikiriPolyfillRoot + "web-gdiplus.tjs");

var fontStorage = global.KirikiriPolyfillRoot + "font.otf";
if (Storages.isExistentStorage(fontStorage)) {
    var faces = Font.addFont(fontStorage);
    if (faces.count) System.setArgument("-deffont", faces[0]);
}

// krkrsdl2 provides a static title image when the original motion is unavailable.
global.webOriginalStorageExists = Storages.isExistentStorage;
Storages.isExistentStorage = function(name) {
    if (name == "title_bg.mtn") return false;
    return global.webOriginalStorageExists(name);
};

Scripts.execStorage("file://./data.xp3>startup.tjs");

// Draw onto the existing button layer when a native TextRender surface is unavailable.
if (typeof SelectButtonLayer == "Object") {
    SelectButtonLayer.drawMessage = function(text) {
        if (text === void) return;
        var x = (this.width - this.font.getTextWidth(text)) >> 1;
        var y = (this.height - this.font.getTextHeight(text)) >> 1;
        this.drawText(x, y, text, 0xFFFFFF, 255);
    };
}
Debug.message("WEB_COMPAT_STARTUP_COMPLETE");
